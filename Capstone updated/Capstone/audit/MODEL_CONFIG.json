{
  "model_architecture": "XGBoost Regressor (XGBRegressor)",
  "objective": "reg:squarederror",
  "tree_method": "hist",
  "enable_categorical": true,
  "learning_rate": 0.05,
  "max_depth": 5,
  "min_child_weight": 3,
  "subsample": 0.8,
  "colsample_bytree": 0.8,
  "n_estimators": 112,
  "best_iteration_selection": "5-fold cross-validation with early_stopping_rounds=50 strictly on pre-cutoff training pool",
  "monotone_constraints": {
    "price": -1,
    "brand_tier": 1,
    "value_for_money": 1,
    "utility": 1,
    "ease_of_use": 1,
    "reliability": 1,
    "design_appeal": 1,
    "after_sales": 1,
    "build_quality": 1,
    "durability": 1,
    "repairability": 1
  },
  "feature_manifest": [
    "price",
    "value_for_money",
    "utility",
    "ease_of_use",
    "reliability",
    "design_appeal",
    "after_sales",
    "build_quality",
    "durability",
    "repairability",
    "value_for_money_mention_rate",
    "utility_mention_rate",
    "ease_of_use_mention_rate",
    "reliability_mention_rate",
    "design_appeal_mention_rate",
    "after_sales_mention_rate",
    "build_quality_mention_rate",
    "durability_mention_rate",
    "repairability_mention_rate",
    "brand_tier",
    "category"
  ],
  "excluded_leaky_features": [
    "avg_rating",
    "rating_count_log",
    "review_velocity",
    "install_count_log",
    "days_since_update"
  ]
}
