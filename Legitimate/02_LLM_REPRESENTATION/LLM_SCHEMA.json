{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLM_COLDSTART_RICH_Schema",
  "type": "object",
  "required": [
    "product_title",
    "brand",
    "category",
    "extracted_attributes",
    "aspect_summaries",
    "overall_extraction_confidence"
  ],
  "properties": {
    "product_title": {"type": "string"},
    "brand": {"type": "string"},
    "category": {"type": "string"},
    "extracted_attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "aspect",
          "attribute_name",
          "attribute_value",
          "source_text",
          "customer_relevance",
          "sentiment_direction",
          "confidence",
          "inference_type"
        ],
        "properties": {
          "aspect": {
            "type": "string",
            "enum": [
              "value_for_money",
              "utility",
              "ease_of_use",
              "reliability",
              "design_appeal",
              "after_sales",
              "build_quality",
              "durability",
              "repairability"
            ]
          },
          "attribute_name": {"type": "string"},
          "attribute_value": {"type": "string"},
          "source_text": {"type": "string"},
          "customer_relevance": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "sentiment_direction": {"type": "number", "minimum": -1.0, "maximum": 1.0},
          "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "inference_type": {
            "type": "string",
            "enum": ["technical_spec", "marketing_claim", "inferred_attribute"]
          }
        }
      }
    },
    "aspect_summaries": {
      "type": "object",
      "required": [
        "value_for_money",
        "utility",
        "ease_of_use",
        "reliability",
        "design_appeal",
        "after_sales",
        "build_quality",
        "durability",
        "repairability"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["score", "confidence", "grounded", "evidence"],
        "properties": {
          "score": {"type": "number", "minimum": 0.0, "maximum": 10.0},
          "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "grounded": {"type": "boolean"},
          "evidence": {"type": "string"}
        }
      }
    },
    "overall_extraction_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
