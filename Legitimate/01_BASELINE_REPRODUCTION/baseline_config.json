{
  "model_architecture": "XGBoost Regressor with Monotone Constraints",
  "n_estimators": 112,
  "learning_rate": 0.05,
  "max_depth": 5,
  "min_child_weight": 3,
  "subsample": 0.8,
  "colsample_bytree": 0.8,
  "monotone_constraints": {
    "price": -1,
    "brand_tier": 1,
    "value_for_money": 1,
    "utility": 1,
    "ease_of_use": 1,
    "reliability": 1,
    "design_appeal": 1,
    "after_sales": 1,
    "build_quality": 1,
    "durability": 1,
    "repairability": 1
  },
  "features": [
    "price",
    "value_for_money",
    "utility",
    "ease_of_use",
    "reliability",
    "design_appeal",
    "after_sales",
    "build_quality",
    "durability",
    "repairability",
    "value_for_money_mention_rate",
    "utility_mention_rate",
    "ease_of_use_mention_rate",
    "reliability_mention_rate",
    "design_appeal_mention_rate",
    "after_sales_mention_rate",
    "build_quality_mention_rate",
    "durability_mention_rate",
    "repairability_mention_rate",
    "brand_tier",
    "category"
  ],
  "random_seed": 42
